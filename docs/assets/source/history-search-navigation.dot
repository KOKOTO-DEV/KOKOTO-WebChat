digraph G {
  graph [bgcolor="#F7F9FC", pad="0.25", nodesep="0.45", ranksep="0.65", fontname="Noto Sans", labelloc="t"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=12, color="#334155", fillcolor="#FFFFFF", margin="0.14,0.09"];
  edge [fontname="Noto Sans", fontsize=10, color="#64748B", fontcolor="#475569", arrowsize=0.8];

  rankdir=LR;
  ui [label="History / Search UI", fillcolor="#E0F2FE"];
  api [label="Exact KWC API handlers\nhistory / search / around", fillcolor="#DBEAFE", penwidth=2];
  policy [label="Session + guest visibility\nsource/date/text filters", fillcolor="#FEF3C7"];
  store [label="History store\nSQLite recommended / JSONL", fillcolor="#F1F5F9"];
  results [label="Bounded result set", fillcolor="#DCFCE7"];
  around [label="Contiguous around-history slice\nolder + newer paging", fillcolor="#ECFEFF"];
  scroll [label="Virtual scroll\nanchor preservation", fillcolor="#F3E8FF"];
  target [label="Target highlight / jump", fillcolor="#E0F2FE"];

  ui -> api;
  api -> policy;
  policy -> store;
  store -> results [label="search"];
  results -> around [label="select result"];
  store -> around [label="authoritative context"];
  around -> scroll -> target;
}
