# KOKOTO WebChat + BlueMap HTTPS reverse proxy example for Caddy v2
#
# Replace map.example.com with your actual domain.
# Install notes: see examples/caddy/INSTALL.md and docs/en/CADDY_HTTPS.md.
#
# External URLs:
#   https://map.example.com/
#   https://map.example.com/chat
#   https://map.example.com/chat/api/...
#
# Internal services:
#   BlueMap         -> http://127.0.0.1:8100
#   KOKOTO WebChat  -> http://127.0.0.1:8899/ and /api

map.example.com {
    encode zstd gzip

    # KOKOTO WebChat API and standalone web.
    # Public /chat is stripped before forwarding: /chat -> /, /chat/api -> /api.
    @chat path /chat /chat/*
    handle @chat {
        uri strip_prefix /chat
        reverse_proxy 127.0.0.1:8899
    }

    # BlueMap web map.
    handle {
        reverse_proxy 127.0.0.1:8100
    }
}
